# Kafka
KAFKA_PORT=29092
KAFKA_PORT_2=29093
KAFKA_PORT_3=29094

# ClickHouse: CLICKHOUSE_PASSWORD is required (compose refuses to start without it)
# One entry point (clickhouse = shard 1, replica 1); the other three nodes are
# internal. Data is sharded 2x and replicated 2x.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=analytics

# S3-compatible object storage for the ClickHouse `cold` TTL volume
# (S3Proxy, not exposed). ClickHouse and S3Proxy share these values.
S3_ACCESS_KEY=s3access
S3_SECRET_KEY=change-me

# Grafana: GRAFANA_ADMIN_PASSWORD is required
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# SEC EDGAR requires a real contact email in the User-Agent
SEC_CONTACT_EMAIL=you@example.com

# Scaling knobs (optional; Compose passes these to the producers)
# SYMBOLS_SHARD shards the Yahoo producer only; pass -e SYMBOLS_SHARD=... to a
# daily producer to shard it too. 0/2 needs a matching 1/2 run.
# SYMBOLS=AAPL,MSFT,GOOG
# SYMBOLS_SHARD=0/2
# CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# CRYPTO_SYMBOLS_SHARD=0/1
# POLL_INTERVAL=60
# POLL_BACKOFF=300
# PUBLISH_TIMEOUT=5

# Pipeline scaling: 4 topic groups; keep FLINK_PARALLELISM <= TOPIC_PARTITIONS
# and TASKMANAGER_SLOTS >= 4 * FLINK_PARALLELISM.
TOPIC_PARTITIONS=3
FLINK_PARALLELISM=1
TASKMANAGER_SLOTS=4
