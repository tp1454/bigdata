# Kafka
KAFKA_PORT=29092
KAFKA_PORT_2=29093
KAFKA_PORT_3=29094

# ClickHouse: CLICKHOUSE_PASSWORD is required (compose refuses to start without it)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=analytics

# Grafana: GRAFANA_ADMIN_PASSWORD is required
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# SEC EDGAR requires a real contact email in the User-Agent
SEC_CONTACT_EMAIL=you@example.com

# Scaling knobs (optional; Compose passes these to the producers)
# SYMBOLS_SHARD shards the Yahoo producer only; pass -e SYMBOLS_SHARD=... to a
# daily producer to shard it too. 0/2 needs a matching 1/2 run.
# SYMBOLS=AAPL,MSFT,GOOG
# SYMBOLS_SHARD=0/2
# CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# CRYPTO_SYMBOLS_SHARD=0/1
# POLL_INTERVAL=60
# POLL_BACKOFF=300
# PUBLISH_TIMEOUT=5
