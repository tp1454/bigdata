# Kafka
KAFKA_PORT=29092
KAFKA_PORT_2=29093
KAFKA_PORT_3=29094

# ClickHouse: CLICKHOUSE_PASSWORD is required and must not stay at a template
# value (make up/deploy reject change-me, clickhouse and admin).
# One entry point (clickhouse = shard 1, replica 1); the other three nodes are
# internal. Data is sharded 2x and replicated 2x.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=analytics

# S3-compatible object storage for the ClickHouse `cold` TTL volume
# (S3Proxy, not exposed). ClickHouse and S3Proxy share these values.
S3_ACCESS_KEY=s3access
S3_SECRET_KEY=change-me

# Grafana: GRAFANA_ADMIN_PASSWORD is required and must not stay a template value
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus (bound to localhost only)
PROMETHEUS_PORT=9090

# SEC EDGAR requires a real contact email in the User-Agent. The
# placeholder below makes the SEC producers fail at startup.
SEC_CONTACT_EMAIL=you@example.com

# No-key sources
# OPTIONS_MAX_EXPIRIES caps Yahoo option-chain requests per symbol (default 8).
# INSTITUTIONAL_CIKS is a comma-separated list of 13F filer CIKs
# (default Berkshire Hathaway).
# OPTIONS_MAX_EXPIRIES=8
# INSTITUTIONAL_CIKS=0001067983

# Scaling knobs (optional; Compose passes these to the producers)
# SYMBOLS_SHARD shards the Yahoo producer only; pass -e SYMBOLS_SHARD=... to a
# daily producer to shard it too. 0/2 needs a matching 1/2 run.
# SYMBOLS=AAPL,MSFT,GOOG
# SYMBOLS_SHARD=0/2
# CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# CRYPTO_SYMBOLS_SHARD=0/1
# POLL_INTERVAL=60
# POLL_BACKOFF=300
# PUBLISH_TIMEOUT=5

# Pipeline scaling: 4 topic groups; keep FLINK_PARALLELISM <= TOPIC_PARTITIONS
# and TASKMANAGER_SLOTS >= 4 * FLINK_PARALLELISM.
TOPIC_PARTITIONS=3
FLINK_PARALLELISM=1
TASKMANAGER_SLOTS=4

# Checkpointing (ms). Raise the timeout while draining a large Kafka backlog.
CHECKPOINT_INTERVAL_MS=60000
CHECKPOINT_TIMEOUT_MS=1800000

# API
API_PORT=4000
MCP_PORT=3001
